<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.reteclock"
    android:versionCode="71"
    android:versionName="0.40.1"
    android:installLocation="auto">

    <!-- minSdk 9 keeps very old devices supported; targetSdk 28 keeps current Android versions
         willing to install the APK. Android 14 refuses targetSdk below 23. -->
    <uses-sdk
        android:minSdkVersion="9"
        android:targetSdkVersion="28" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The timer's vibrate mode. An install-time permission, so nothing is ever prompted for at
         runtime and R5 still holds; it is here only because the timer offers vibration. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Alarms (experimental), RFC-0012. Both are ordinary permissions granted at install, so R5
         holds; the components that use them ship disabled below and are enabled only while the
         experiment is switched on. RECEIVE_BOOT_COMPLETED re-arms the next alarm after a restart;
         FOREGROUND_SERVICE keeps a ringing alarm alive, and is required at targetSdk 28. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- A television, when there is one (issue #45, RFC-0009).

         Leanback is what a TV home screen looks for and is not required: the same APK is a phone
         app. The touchscreen line is the one that matters most — it is *required* by default, so
         without it the app declares itself unfit for the device it is being installed on. The
         clock has never needed one: everything it does answers a key as well (R102, R103). -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true"
        android:anyDensity="true" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:banner="@drawable/banner"
        android:label="@string/app_name"
        android:theme="@style/ClockTheme">

        <activity
            android:name=".ClockActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|navigation|uiMode|smallestScreenSize"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/ClockTheme">
            <!-- The home-screen button opens the clock (issue #39), as it did before an unusable
                 picture made a door necessary. The door is still there and still opens by itself:
                 a run that never came back sends the next tap to the settings, and so does the
                 switch for anybody who prefers it. See LaunchRoute. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.DESK_DOCK" />
                <!-- A TV home screen lists only what carries this, and draws it as the banner
                     below rather than as an icon. Harmless on a phone, which ignores it. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Long-pressing the icon offers the settings, on the versions that have shortcuts
                 (API 25 and up). Older ones ignore this, and reach the settings from the clock. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".TimerSettingsActivity"
            android:exported="false"
            android:label="@string/timer_title"
            android:theme="@android:style/Theme.Black" />

        <activity
            android:name=".AlarmSettingsActivity"
            android:exported="false"
            android:label="@string/alarm_title"
            android:theme="@android:style/Theme.Black" />

        <!-- The card for an alarm, over the lock screen. Disabled until the experiment is on. -->
        <activity
            android:name=".WakeCardActivity"
            android:enabled="false"
            android:exported="false"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.reteclock.wake"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <activity
            android:name=".SoundSettingsActivity"
            android:exported="false"
            android:label="@string/sound_title"
            android:theme="@android:style/Theme.Black" />

        <activity
            android:name=".TimeDateSettingsActivity"
            android:exported="false"
            android:label="@string/timedate_title"
            android:theme="@android:style/Theme.Black" />

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:theme="@android:style/Theme.Black">
            <!-- Exported without the launcher category: it is no longer the front door, but the
                 icon's shortcut menu starts it, and that is the launcher starting it. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ImageTrialActivity"
            android:exported="false"
            android:label="@string/quality_trial_title"
            android:theme="@android:style/Theme.Black" />

        <activity
            android:name=".LayoutSettingsActivity"
            android:exported="false"
            android:label="@string/layout_title"
            android:theme="@android:style/Theme.Black" />

        <activity
            android:name=".LayoutEditorActivity"
            android:exported="false"
            android:label="@string/layout_title"
            android:theme="@android:style/Theme.Black" />

        <activity
            android:name=".LayoutFieldsActivity"
            android:exported="false"
            android:label="@string/layout_fields_title"
            android:theme="@android:style/Theme.Black" />


        <service
            android:name=".ClockDreamService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/dream_info" />
        </service>

        <!-- Alarms (experimental), RFC-0012: disabled until the experiment is switched on, so with it
             off a restart does not start this app at all. -->
        <receiver
            android:name=".WakeReceiver"
            android:enabled="false"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".WakeRingService"
            android:enabled="false"
            android:exported="false"
            android:directBootAware="true" />

        <receiver
            android:name=".PowerConnectionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
